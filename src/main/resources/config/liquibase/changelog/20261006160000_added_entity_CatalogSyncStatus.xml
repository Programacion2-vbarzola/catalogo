<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261006160000-1" author="catalogo">
        <createTable tableName="catalog_sync_status">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="local_version" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="applied_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="sync_type" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="error_message" type="varchar(1000)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <dropDefaultValue tableName="catalog_sync_status" columnName="applied_at" columnDataType="${datetimeType}"/>
    </changeSet>
</databaseChangeLog>
