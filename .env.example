# Configuración de integración con el servicio de cátedra.
# Copiar a .env y completar con los valores reales recibidos del servicio de registro.
# NUNCA commitear .env ni exponer estos valores.

# REST base URL del servicio central de cátedra
CATEDRA_REST_BASE_URL=

# Redis de cátedra (valores recibidos en integration.redisHost / redisPort / redisUsername / redisPassword)
CATEDRA_REDIS_HOST=
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=
CATEDRA_REDIS_PASSWORD=
CATEDRA_REDIS_READ_NAMESPACE=catedra:sync:*
CATEDRA_REDIS_WRITE_NAMESPACE=

# Kafka de cátedra (valores recibidos en integration.kafkaBootstrapServers / kafkaConsumerGroupId / topics)
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CONSUMER_GROUP_ID=
CATEDRA_KAFKA_CATALOG_TOPIC=
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=

# Secreto JWT compartido con el servicio de turnos y reservas (Repo 3).
# Mismo valor que SHARED_JWT_SECRET en Repo 3 — los tokens firmados por Repo 3 son aceptados automáticamente.
# Debe ser Base64, mínimo 256 bits. Generar con: openssl rand -base64 64
SHARED_JWT_SECRET=
